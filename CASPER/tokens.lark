// ======= Basic Tokens =======
IDENT: /\$[a-zA-Z_][a-zA-Z0-9_]*/  // Must start with $
INT_LIT: /[0-9]+/                   
FLT_LIT: /[0-9]+\.[0-9]+/           
BLN_LIT: "Day" | "Night"           
STR_LIT: /"[^"]*"/                  
CHR_LIT: /'[^']'/                   

// ======= Operators =======
PLUS: "+"
MINUS: "-"
MULTIPLY: "*"
DIVISION: "/"
MODULO: "%"
EXPONENT: "**"

EQ: "="
PLUS_EQ: "+="
MINUS_EQ: "-="
MUL_EQ: "*="
DIV_EQ: "/="
MOD_EQ: "%="

EQ_EQ: "=="
NOT_EQ: "!="
LT: "<"
GT: ">"
LT_EQ: "<="
GT_EQ: ">="

AND: "&&"
OR: "||"
NOT: "!"

TILDE: "~"
PLUS_PLUS: "++"
MINUS_MINUS: "--"

// ======= Delimiters =======
LPAREN: "("
RPAREN: ")"
LBRACE: "{"
RBRACE: "}"
LBRACKET: "["
RBRACKET: "]"
SEMICOLON: ";"
COLON: ":"
COMMA: ","

// ======= Keywords =======
BIRTH: "birth"
GHOST: "ghost"
INPUT: "input"
DISPLAY: "display"
CHECK: "check"
OTHERWISE: "otherwise"
OTHERWISE_CHECK: "otherwise_check"
FOR: "for"
REPEAT: "repeat"
UNTIL: "until"
STOP: "stop"
SKIP: "skip"
SWAP: "swap"
SHIFT: "shift"
REVIVE: "revive"
MEASURE: "measure"
IN: "in"

// ======= Function Related =======
FUNCTION_NAME: /@[a-zA-Z_][a-zA-Z0-9_]*/
MAIN_CASPER: "@main_casper"

// ======= Type Conversions =======
CONVERT_TO_INT: "to_int"
CONVERT_TO_STR: "to_str"
CONVERT_TO_BLN: "to_bln"
CONVERT_TO_FLT: "to_flt"

// ======= Ignore Whitespace =======
%import common.WS
%ignore WS
